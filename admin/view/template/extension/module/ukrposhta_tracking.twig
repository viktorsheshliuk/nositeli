{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-ukrposhta-tracking" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_back }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-ukrposhta-tracking" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_ukrposhta_tracking_status" id="input-status" class="form-control">
                <option value="0" {{ "0" == module_ukrposhta_tracking_status ? "selected" : "" }}>{{ text_disabled }}</option>
                <option value="1" {{ "1" == module_ukrposhta_tracking_status ? "selected" : "" }}>{{ text_enabled }}</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-bearer">{{ entry_ukr_bearer }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_ukrposhta_tracking_bearer" value="{{ module_ukrposhta_tracking_bearer|escape }}" id="input-bearer" class="form-control"/>
              <div class="help-block">{{ help_ukr_bearer }}</div>
            </div>
          </div>

          <hr/>

          <div class="alert alert-info">
            <i class="fa fa-info-circle"></i> {{ text_cron_info }}
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ text_cron_url }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" value="{{ cron_url|escape }}" id="input-cron-url" class="form-control" readonly/>
                <span class="input-group-btn">
                  <button type="button" class="btn btn-default" id="copy-cron-url" data-toggle="tooltip" title="{{ button_cron_copy }}"><i class="fa fa-copy"></i></button>
                </span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-tracking-enabled">{{ entry_ukr_tracking_enabled }}</label>
            <div class="col-sm-10">
              <select name="module_ukrposhta_tracking_tracking_enabled" id="input-tracking-enabled" class="form-control">
                <option value="0" {{ "0" == module_ukrposhta_tracking_tracking_enabled ? "selected" : "" }}>{{ text_disabled }}</option>
                <option value="1" {{ "1" == module_ukrposhta_tracking_tracking_enabled ? "selected" : "" }}>{{ text_enabled }}</option>
              </select>
              <div class="help-block">{{ help_ukr_tracking_enabled }}</div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_ukr_tracking_statuses }}</label>
            <div class="col-sm-10">
              <input type="hidden" name="ukr_tracking_statuses_present" value="1"/>
              <div id="tracking-statuses"></div>
              <div class="help-block">{{ help_ukr_tracking_statuses }}</div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-cron-key">{{ entry_ukr_cron_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_ukrposhta_tracking_cron_key" value="{{ module_ukrposhta_tracking_cron_key|escape }}" id="input-cron-key" class="form-control"/>
              <div class="help-block">{{ help_ukr_cron_key }}</div>
            </div>
          </div>

          <hr/>

          <h4><i class="fa fa-exchange"></i> {{ text_status_mapping }}</h4>
          <div class="alert alert-info">{{ help_status_mapping }}</div>

          <input type="hidden" name="ukr_status_map_present" value="1"/>

          <div id="status-map-empty" class="alert alert-warning"{% if module_ukrposhta_tracking_status_map %} style="display: none;"{% endif %}>{{ text_status_map_empty }}</div>


<style>
  .ukr-multiselect { position: relative; }
  .ukr-multiselect-panel { display: none; position: absolute; z-index: 1000; left: 0; right: 0; max-height: 260px; overflow-y: auto; background: #fff; border: 1px solid #ccc; border-radius: 4px; padding: 6px 10px; }
  .ukr-multiselect-panel label { display: block; font-weight: normal; margin: 0; padding: 3px 0; cursor: pointer; }
  .ukr-multiselect.open .ukr-multiselect-panel { display: block; }
  .ukr-multiselect-label { display: inline-block; max-width: 90%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; }
</style>

<script type="text/javascript"><!--
$(document).ready(function() {
// Події Укрпошти, статуси замовлень та збережена відповідність
var ukrStatuses = {{ ukrposhta_statuses|json_encode() }};
var ukrOrderStatuses = {{ order_statuses|json_encode() }};
var ukrTrackingStatuses = {{ module_ukrposhta_tracking_tracking_statuses|json_encode() }};
var ukrStatusMap = {{ module_ukrposhta_tracking_status_map|json_encode() }};

var ukrText = {
    none: '{{ text_ukr_statuses_none|escape('js') }}',
    selected: '{{ text_ukr_statuses_selected|escape('js') }}',
    selectAll: '{{ text_ukr_select_all|escape('js') }}',
    deselectAll: '{{ text_ukr_deselect_all|escape('js') }}',
    selectStatus: '{{ text_select_status|escape('js') }}',
    duplicate: '{{ error_ukr_status_map_duplicate|escape('js') }}',
    result: '{{ text_tracking_result|escape('js') }}',
    copied: '{{ text_cron_copied|escape('js') }}'
};

// Оновлення підпису мультивибору
function ukrUpdateMultiselectLabel($multiselect) {
    var $checked = $multiselect.find('input[type="checkbox"]:checked');
    var label = '';

    if (!$checked.length) {
        label = ukrText.none;
    } else {
        var names = [];

        $checked.slice(0, 2).each(function () {
            names.push($(this).attr('data-label'));
        });

        label = ukrText.selected + ' ' + $checked.length + ': ' + names.join(', ');

        if ($checked.length > 2) {
            label += ' ...';
        }
    }

    $multiselect.find('.ukr-multiselect-label').text(label);
}

// Побудова мультивибору з чекбоксів
function ukrBuildMultiselect(inputName, items, selected) {
    var selectedValues = [];
    var html = '';

    // Значення з налаштувань можуть приходити числами, а value чекбоксу завжди рядок
    $.each(selected || [], function (index, value) {
        selectedValues.push(String(value));
    });

    html += '<div class="ukr-multiselect">';
    html += '<button type="button" class="btn btn-default form-control text-left ukr-multiselect-toggle"><span class="ukr-multiselect-label"></span><span class="caret pull-right"></span></button>';
    html += '<div class="ukr-multiselect-panel">';
    html += '<a href="#" class="ukr-multiselect-all">' + ukrText.selectAll + '</a> | <a href="#" class="ukr-multiselect-none">' + ukrText.deselectAll + '</a>';
    html += '<hr style="margin: 5px 0;"/>';

    $.each(items, function (index, item) {
        var checked = $.inArray(String(item.value), selectedValues) !== -1 ? ' checked' : '';

        html += '<label><input type="checkbox" name="' + inputName + '" value="' + item.value + '" data-label="' + item.label + '"' + checked + '/> [' + item.value + '] ' + item.label + '</label>';
    });

    html += '</div></div>';

    return html;
}

// Статуси замовлень, які потрібно відслідковувати
var ukrTrackingItems = [];

$.each(ukrOrderStatuses, function (index, orderStatus) {
    ukrTrackingItems.push({
        value: orderStatus.order_status_id,
        label: orderStatus.name
    });
});

$('#tracking-statuses').html(ukrBuildMultiselect('module_ukrposhta_tracking_tracking_statuses[]', ukrTrackingItems, ukrTrackingStatuses));

$('#tracking-statuses').find('.ukr-multiselect').each(function () {
    ukrUpdateMultiselectLabel($(this));
});

// Події Укрпошти для вибору
var ukrStatusItems = [];

$.each(ukrStatuses, function (statusCode, statusName) {
    ukrStatusItems.push({
        value: statusCode,
        label: statusName
    });
});

var ukrStatusMapIndex = 0;

function ukrUpdateStatusMapEmpty() {
    if ($('#status-map-rows .status-map-row').length) {
        $('#status-map-empty').hide();
    } else {
        $('#status-map-empty').show();
    }
}

function ukrAddStatusMapRow(row) {
    var index = ukrStatusMapIndex++;
    var selected = row && row['statuses'] ? row['statuses'] : [];
    var orderStatusId = row && row['order_status_id'] ? String(row['order_status_id']) : '';

    var html = '';

    html += '<div class="form-group status-map-row">';
    html += '<div class="col-sm-offset-2 col-sm-5" style="margin-bottom: 5px;">';
    html += ukrBuildMultiselect('module_ukrposhta_tracking_status_map[' + index + '][statuses][]', ukrStatusItems, selected);
    html += '</div>';
    html += '<div class="col-sm-4" style="margin-bottom: 5px;">';
    html += '<select name="module_ukrposhta_tracking_status_map[' + index + '][order_status_id]" class="form-control">';
    html += '<option value="">' + ukrText.selectStatus + '</option>';

    $.each(ukrOrderStatuses, function (i, orderStatus) {
        var selectedAttr = String(orderStatus.order_status_id) === orderStatusId ? ' selected' : '';

        html += '<option value="' + orderStatus.order_status_id + '"' + selectedAttr + '>' + orderStatus.name + '</option>';
    });

    html += '</select>';
    html += '</div>';
    html += '<div class="col-sm-1" style="margin-bottom: 5px;">';
    html += '<button type="button" class="btn btn-danger remove-status-map-row"><i class="fa fa-minus-circle"></i></button>';
    html += '</div>';
    html += '</div>';

    var $row = $(html);

    $('#status-map-rows').append($row);

    $row.find('.ukr-multiselect').each(function () {
        ukrUpdateMultiselectLabel($(this));
    });

    ukrUpdateStatusMapEmpty();
}

$.each(ukrStatusMap, function (index, row) {
    ukrAddStatusMapRow(row);
});

ukrUpdateStatusMapEmpty();

// Додати рядок відповідності
$('#add-status-map-row').on('click', function () {
    ukrAddStatusMapRow(null);
});

// Видалити рядок відповідності
$(document).on('click', '.remove-status-map-row', function (e) {
    e.preventDefault();

    $(this).closest('.status-map-row').remove();

    ukrUpdateStatusMapEmpty();
});

// Відкрити/закрити список
$(document).on('click', '.ukr-multiselect-toggle', function (e) {
    e.preventDefault();

    var $multiselect = $(this).closest('.ukr-multiselect');

    $('.ukr-multiselect.open').not($multiselect).removeClass('open');

    $multiselect.toggleClass('open');
});

// Закрити список при кліку поза ним
$(document).on('click', function (e) {
    if (!$(e.target).closest('.ukr-multiselect').length) {
        $('.ukr-multiselect.open').removeClass('open');
    }
});

$(document).on('change', '.ukr-multiselect input[type="checkbox"]', function () {
    ukrUpdateMultiselectLabel($(this).closest('.ukr-multiselect'));
});

$(document).on('click', '.ukr-multiselect-all', function (e) {
    e.preventDefault();

    $(this).closest('.ukr-multiselect').find('input[type="checkbox"]').prop('checked', true).trigger('change');
});

$(document).on('click', '.ukr-multiselect-none', function (e) {
    e.preventDefault();

    $(this).closest('.ukr-multiselect').find('input[type="checkbox"]').prop('checked', false).trigger('change');
});

// Перевірка дублів кодів Укрпошти перед збереженням
$('#form-ukrposhta-tracking').on('submit', function () {
    var used = {};
    var duplicates = [];

    $('#status-map-rows input[type="checkbox"]:checked').each(function () {
        var code = $(this).val();

        if (used[code]) {
            duplicates.push(code);
        } else {
            used[code] = true;
        }
    });

    if (duplicates.length) {
        alert(ukrText.duplicate + duplicates.join(', '));

        return false;
    }
});

// Копіювати URL cron
$('#copy-cron-url').on('click', function () {
    var input = document.getElementById('input-cron-url');

    input.select();
    input.setSelectionRange(0, 99999);

    try {
        document.execCommand('copy');

        alert(ukrText.copied);
    } catch (error) {
        alert(input.value);
    }
});

// Оновити статуси зараз
$('#run-tracking').on('click', function () {
    var node = this;

    $.ajax({
        url: 'index.php?route=extension/module/ukrposhta_tracking/runTracking&user_token={{ user_token }}',
        type: 'post',
        dataType: 'json',
        beforeSend: function () {
            $(node).prop('disabled', true);
            $(node).find('i').addClass('fa-spin');
        },
        success: function (json) {
            if (json['errors'] && json['errors'].length) {
                alert(json['errors'].join("\r\n"));
            }

            if (typeof json['processed'] !== 'undefined') {
                alert(ukrText.result.replace('%s', json['processed']).replace('%s', json['updated']).replace('%s', json['skipped']));
            }
        },
        error: function (xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        },
        complete: function () {
            $(node).find('i').removeClass('fa-spin');
            $(node).prop('disabled', false);
        }
    });
});
});
//--></script>

          <div id="status-map-rows"></div>

          <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
              <button type="button" class="btn btn-success" id="add-status-map-row"><i class="fa fa-plus"></i> {{ button_add_mapping }}</button>
              <button type="button" class="btn btn-primary" id="run-tracking"><i class="fa fa-refresh"></i> {{ button_run_tracking }}</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}

