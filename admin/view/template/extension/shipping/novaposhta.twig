    <script type="text/javascript"><!--
    // Статуси Нової Пошти, статуси замовлень та збережена відповідність
    var npStatuses = {{ novaposhta_statuses|json_encode() }};
    var npOrderStatuses = {{ order_statuses|json_encode() }};
    var npTrackingStatuses = {{ shipping_novaposhta_tracking_statuses|json_encode() }};
    var npStatusMap = {{ shipping_novaposhta_status_map|json_encode() }};

    var npText = {
        none: '{{ text_np_statuses_none|escape('js') }}',
        selected: '{{ text_np_statuses_selected|escape('js') }}',
        selectAll: '{{ text_np_select_all|escape('js') }}',
        deselectAll: '{{ text_np_deselect_all|escape('js') }}',
        selectStatus: '{{ text_select_status|escape('js') }}',
        duplicate: '{{ error_np_status_map_duplicate|escape('js') }}',
        result: '{{ text_tracking_result|escape('js') }}',
        copied: '{{ text_cron_copied|escape('js') }}'
    };

    // Оновлення підпису мультивибору
    function npUpdateMultiselectLabel($multiselect) {
        var $checked = $multiselect.find('input[type="checkbox"]:checked');
        var label = '';

        if (!$checked.length) {
            label = npText.none;
        } else {
            var names = [];

            $checked.slice(0, 2).each(function () {
                names.push($(this).attr('data-label'));
            });

            label = npText.selected + ' ' + $checked.length + ': ' + names.join(', ');

            if ($checked.length > 2) {
                label += ' ...';
            }
        }

        $multiselect.find('.np-multiselect-label').text(label);
    }

    // Побудова мультивибору з чекбоксів
    function npBuildMultiselect(inputName, items, selected) {
        var selectedValues = [];
        var html = '';

        // Значення з налаштувань можуть приходити числами, а value чекбоксу завжди рядок
        $.each(selected || [], function (index, value) {
            selectedValues.push(String(value));
        });

        html += '<div class="np-multiselect">';
        html += '<button type="button" class="btn btn-default form-control text-left np-multiselect-toggle"><span class="np-multiselect-label"></span><span class="caret pull-right"></span></button>';
        html += '<div class="np-multiselect-panel">';
        html += '<a href="#" class="np-multiselect-all">' + npText.selectAll + '</a> | <a href="#" class="np-multiselect-none">' + npText.deselectAll + '</a>';
        html += '<hr style="margin: 5px 0;"/>';

        $.each(items, function (index, item) {
            var checked = $.inArray(String(item.value), selectedValues) !== -1 ? ' checked' : '';

            html += '<label><input type="checkbox" name="' + inputName + '" value="' + item.value + '" data-label="' + item.label + '"' + checked + '/> [' + item.value + '] ' + item.label + '</label>';
        });

        html += '</div></div>';

        return html;
    }
    // Статуси замовлень, які потрібно відслідковувати
    var npTrackingItems = [];

    $.each(npOrderStatuses, function (index, orderStatus) {
        npTrackingItems.push({
            value: orderStatus.order_status_id,
            label: orderStatus.name
        });
    });

    $('#tracking-statuses').html(npBuildMultiselect('shipping_novaposhta_tracking_statuses[]', npTrackingItems, npTrackingStatuses));

    $('#tracking-statuses').find('.np-multiselect').each(function () {
        npUpdateMultiselectLabel($(this));
    });

    // Статуси Нової Пошти для вибору
    var npStatusItems = [];

    $.each(npStatuses, function (statusCode, statusName) {
        npStatusItems.push({
            value: statusCode,
            label: statusName
        });
    });

    var npStatusMapIndex = 0;

    function npUpdateStatusMapEmpty() {
        if ($('#status-map-rows .status-map-row').length) {
            $('#status-map-empty').hide();
        } else {
            $('#status-map-empty').show();
        }
    }

    function npAddStatusMapRow(row) {
        var index = npStatusMapIndex++;
        var selected = row && row['statuses'] ? row['statuses'] : [];
        var orderStatusId = row && row['order_status_id'] ? String(row['order_status_id']) : '';

        var html = '';

        html += '<div class="form-group status-map-row">';
        html += '<div class="col-sm-offset-2 col-sm-5" style="margin-bottom: 5px;">';
        html += npBuildMultiselect('shipping_novaposhta_status_map[' + index + '][statuses][]', npStatusItems, selected);
        html += '</div>';
        html += '<div class="col-sm-4" style="margin-bottom: 5px;">';
        html += '<select name="shipping_novaposhta_status_map[' + index + '][order_status_id]" class="form-control">';
        html += '<option value="">' + npText.selectStatus + '</option>';

        $.each(npOrderStatuses, function (i, orderStatus) {
            var selectedAttr = String(orderStatus.order_status_id) === orderStatusId ? ' selected' : '';

            html += '<option value="' + orderStatus.order_status_id + '"' + selectedAttr + '>' + orderStatus.name + '</option>';
        });

        html += '</select>';
        html += '</div>';
        html += '<div class="col-sm-1" style="margin-bottom: 5px;">';
        html += '<button type="button" class="btn btn-danger remove-status-map-row"><i class="fa fa-minus-circle"></i></button>';
        html += '</div>';
        html += '</div>';

        var $row = $(html);

        $('#status-map-rows').append($row);

        $row.find('.np-multiselect').each(function () {
            npUpdateMultiselectLabel($(this));
        });

        npUpdateStatusMapEmpty();
    }

    $.each(npStatusMap, function (index, row) {
        npAddStatusMapRow(row);
    });

    npUpdateStatusMapEmpty();
    // Додати рядок відповідності
    $('#add-status-map-row').on('click', function () {
        npAddStatusMapRow(null);
    });

    // Видалити рядок відповідності
    $(document).on('click', '.remove-status-map-row', function (e) {
        e.preventDefault();

        $(this).closest('.status-map-row').remove();

        npUpdateStatusMapEmpty();
    });

    // Відкрити/закрити список
    $(document).on('click', '.np-multiselect-toggle', function (e) {
        e.preventDefault();

        var $multiselect = $(this).closest('.np-multiselect');

        $('.np-multiselect.open').not($multiselect).removeClass('open');

        $multiselect.toggleClass('open');
    });

    // Закрити список при кліку поза ним
    $(document).on('click', function (e) {
        if (!$(e.target).closest('.np-multiselect').length) {
            $('.np-multiselect.open').removeClass('open');
        }
    });

    $(document).on('change', '.np-multiselect input[type="checkbox"]', function () {
        npUpdateMultiselectLabel($(this).closest('.np-multiselect'));
    });

    $(document).on('click', '.np-multiselect-all', function (e) {
        e.preventDefault();

        $(this).closest('.np-multiselect').find('input[type="checkbox"]').prop('checked', true).trigger('change');
    });

    $(document).on('click', '.np-multiselect-none', function (e) {
        e.preventDefault();

        $(this).closest('.np-multiselect').find('input[type="checkbox"]').prop('checked', false).trigger('change');
    });

    // Перевірка дублів кодів Нової Пошти перед збереженням
    $('#form-shipping').on('submit', function () {
        var used = {};
        var duplicates = [];

        $('#status-map-rows input[type="checkbox"]:checked').each(function () {
            var code = $(this).val();

            if (used[code]) {
                duplicates.push(code);
            } else {
                used[code] = true;
            }
        });

        if (duplicates.length) {
            alert(npText.duplicate + duplicates.join(', '));

            return false;
        }
    });

    // Копіювати URL cron
    $('#copy-cron-url').on('click', function () {
        var input = document.getElementById('input-cron-url');

        input.select();
        input.setSelectionRange(0, 99999);

        try {
            document.execCommand('copy');

            alert(npText.copied);
        } catch (error) {
            alert(input.value);
        }
    });

    // Оновити статуси зараз
    $('#run-tracking').on('click', function () {
        var node = this;

        $.ajax({
            url: 'index.php?route=extension/shipping/novaposhta/runTracking&user_token={{ user_token }}',
            type: 'post',
            dataType: 'json',
            beforeSend: function () {
                $(node).prop('disabled', true);
                $(node).find('i').addClass('fa-spin');
            },
            success: function (json) {
                if (json['errors'] && json['errors'].length) {
                    alert(json['errors'].join("\r\n"));
                }

                if (typeof json['processed'] !== 'undefined') {
                    alert(npText.result.replace('%s', json['processed']).replace('%s', json['updated']).replace('%s', json['skipped']));
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            },
            complete: function () {
                $(node).find('i').removeClass('fa-spin');
                $(node).prop('disabled', false);
            }
        });
    });
    //--></script>

</div>
{{ footer }}