    <script type="text/javascript"><!--
    // Поиск города отправителя
    $('#sender-city-search').on('input', function() {
        var search = $(this).val();
        
        if (search.length >= 2) {
            $.ajax({
                url: 'index.php?route=extension/shipping/novaposhta/searchSenderCities&user_token={{ user_token }}&search=' + encodeURIComponent(search),
                type: 'GET',
                dataType: 'json',
                success: function(json) {
                    var html = '';
                    
                    if (json.length > 0) {
                        $.each(json, function(index, city) {
                            html += '<a href="#" class="list-group-item sender-city-item" data-ref="' + city.ref + '" data-name="' + city.name + '">' + city.name + '</a>';
                        });
                    } else {
                        html = '<div class="list-group-item">Ничего не найдено</div>';
                    }
                    
                    $('#sender-city-results').html(html).show();
                },
                error: function(xhr, ajaxOptions, thrownError) {
                    console.error(thrownError);
                }
            });
        } else {
            $('#sender-city-results').hide();
        }
    });
    
    // Выбор города отправителя
    $(document).on('click', '.sender-city-item', function(e) {
        e.preventDefault();
        
        var cityRef = $(this).data('ref');
        var cityName = $(this).data('name');
        
        $('#sender-city-search').val(cityName);
        $('#sender-city-ref').val(cityRef);
        $('#sender-city-name').val(cityName);
        $('#sender-city-results').hide();
        
        // Загрузка отделений
        $.ajax({
            url: 'index.php?route=extension/shipping/novaposhta/getSenderWarehouses&user_token={{ user_token }}&city_ref=' + encodeURIComponent(cityRef),
            type: 'GET',
            dataType: 'json',
            beforeSend: function() {
                $('#sender-warehouse-select').html('<option value="">Загрузка...</option>');
            },
            success: function(json) {
                var html = '<option value="">Выберите отделение</option>';
                
                if (json.length > 0) {
                    $.each(json, function(index, warehouse) {
                        html += '<option value="' + warehouse.ref + '">' + warehouse.name + '</option>';
                    });
                }
                
                $('#sender-warehouse-select').html(html);
            },
            error: function(xhr, ajaxOptions, thrownError) {
                console.error(thrownError);
                $('#sender-warehouse-select').html('<option value="">Ошибка загрузки</option>');
            }
        });
    });
    
    // Выбор отделения отправителя
    $('#sender-warehouse-select').on('change', function() {
        var warehouseName = $(this).find('option:selected').text();
        $('#sender-warehouse-name').val(warehouseName);
    });
    
    // Скрытие списка городов при клике вне
    $(document).on('click', function(e) {
        if (!$(e.target).closest('#sender-city-results').length) {
            $('#sender-city-results').hide();
        }
    });
    
    // Обновление отделений
    $('#update-departments').on('click', function () {
