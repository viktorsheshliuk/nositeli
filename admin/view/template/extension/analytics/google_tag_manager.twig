{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-gtm" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
          <i class="fa fa-save"></i> {{ button_save }}
        </button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default">
          <i class="fa fa-reply"></i> {{ button_cancel }}
        </a>
      </div>
      <h1><i class="fa fa-google"></i> {{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible">
      <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-gtm" class="form-horizontal">
          
          <!-- Навігаційні табби -->
          <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" class="active">
              <a href="#settings" aria-controls="settings" role="tab" data-toggle="tab">
                <i class="fa fa-cog"></i> Налаштування
              </a>
            </li>
            <li role="presentation">
              <a href="#events" aria-controls="events" role="tab" data-toggle="tab">
                <i class="fa fa-bar-chart"></i> {{ entry_events }}
              </a>
            </li>
          </ul>
          
          <!-- Контент табів -->
          <div class="tab-content" style="margin-top: 15px;">
            
            <!-- Таб налаштувань -->
            <div role="tabpanel" class="tab-pane active" id="settings">
              
              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="btn-group" data-toggle="buttons">
                    {% if analytics_google_tag_manager_status %}
                    <label class="btn btn-success active">
                      <input type="radio" name="analytics_google_tag_manager_status" value="1" checked="checked" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger">
                      <input type="radio" name="analytics_google_tag_manager_status" value="0" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% else %}
                    <label class="btn btn-success">
                      <input type="radio" name="analytics_google_tag_manager_status" value="1" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger active">
                      <input type="radio" name="analytics_google_tag_manager_status" value="0" checked="checked" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% endif %}
                  </div>
                </div>
              </div>
              
              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-container-id">
                  <span data-toggle="tooltip" title="{{ help_container_id }}">
                    {{ entry_container_id }}
                  </span>
                </label>
                <div class="col-sm-10">
                    <input type="text" name="analytics_google_tag_manager_container_id" 
                           value="{{ analytics_google_tag_manager_container_id }}" 
                           placeholder="XXXXXXX" id="input-container-id" class="form-control" />
                  {% if error_container_id %}
                  <div class="text-danger"><i class="fa fa-warning"></i> {{ error_container_id }}</div>
                  {% endif %}
                  <small class="help-block text-muted">
                    Введіть ваш Container ID з Google Tag Manager (наприклад: GTM-XXXXXXX)
                  </small>
                </div>
              </div>
              
              <div class="alert alert-info">
                <i class="fa fa-info-circle"></i>
                <strong>Інформація:</strong> Google Tag Manager дозволяє керувати всіма тегами та скриптами вашого сайту з одного місця. 
                Після введення Container ID, перейдіть на вкладку "Події" для налаштування E-commerce відстеження.
              </div>
              
            </div>
            
            <!-- Таб подій -->
            <div role="tabpanel" class="tab-pane" id="events">
              
              <div class="alert alert-success">
                <i class="fa fa-shopping-cart"></i>
                <strong>E-commerce відстеження:</strong> Налаштуйте які події відстежувати для аналітики Google Analytics 4
              </div>
              
              <div class="form-group">
                <label class="col-sm-3 control-label">
                  <i class="fa fa-eye text-primary"></i> {{ entry_view_item }}
                  <br><small class="text-muted"><code>view_item</code></small>
                </label>
                <div class="col-sm-9">
                  <div class="btn-group" data-toggle="buttons">
                    {% if analytics_google_tag_manager_view_item %}
                    <label class="btn btn-success active">
                      <input type="radio" name="analytics_google_tag_manager_view_item" value="1" checked="checked" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger">
                      <input type="radio" name="analytics_google_tag_manager_view_item" value="0" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% else %}
                    <label class="btn btn-success">
                      <input type="radio" name="analytics_google_tag_manager_view_item" value="1" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger active">
                      <input type="radio" name="analytics_google_tag_manager_view_item" value="0" checked="checked" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% endif %}
                  </div>
                  <div class="help-block">Відстежує перегляди сторінок товарів</div>
                </div>
              </div>
              
              <div class="form-group">
                <label class="col-sm-3 control-label">
                  <i class="fa fa-cart-plus text-warning"></i> {{ entry_add_to_cart }}
                  <br><small class="text-muted"><code>add_to_cart</code></small>
                </label>
                <div class="col-sm-9">
                  <div class="btn-group" data-toggle="buttons">
                    {% if analytics_google_tag_manager_add_to_cart %}
                    <label class="btn btn-success active">
                      <input type="radio" name="analytics_google_tag_manager_add_to_cart" value="1" checked="checked" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger">
                      <input type="radio" name="analytics_google_tag_manager_add_to_cart" value="0" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% else %}
                    <label class="btn btn-success">
                      <input type="radio" name="analytics_google_tag_manager_add_to_cart" value="1" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger active">
                      <input type="radio" name="analytics_google_tag_manager_add_to_cart" value="0" checked="checked" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% endif %}
                  </div>
                  <div class="help-block">Відстежує додавання товарів до кошика</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">
                  <i class="fa fa-cart-plus text-warning"></i> {{ entry_remove_from_cart }}
                  <br><small class="text-muted"><code>remove_from_cart</code></small>
                </label>
                <div class="col-sm-9">
                  <div class="btn-group" data-toggle="buttons">
                    {% if analytics_google_tag_manager_remove_from_cart %}
                    <label class="btn btn-success active">
                      <input type="radio" name="analytics_google_tag_manager_remove_from_cart" value="1" checked="checked" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger">
                      <input type="radio" name="analytics_google_tag_manager_remove_from_cart" value="0" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% else %}
                    <label class="btn btn-success">
                      <input type="radio" name="analytics_google_tag_manager_remove_from_cart" value="1" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger active">
                      <input type="radio" name="analytics_google_tag_manager_remove_from_cart" value="0" checked="checked" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% endif %}
                  </div>
                  <div class="help-block">Відстежує видалення товару з кошика</div>
                </div>
              </div>

              {# <div class="form-group">
                <label class="col-sm-3 control-label">
                  <i class="fa fa-cart-plus text-warning"></i> {{ entry_view_cart }}
                  <br><small class="text-muted"><code>view_cart</code></small>
                </label>
                <div class="col-sm-9">
                  <div class="btn-group" data-toggle="buttons">
                    {% if analytics_google_tag_manager_view_cart %}
                    <label class="btn btn-success active">
                      <input type="radio" name="analytics_google_tag_manager_view_cart" value="1" checked="checked" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger">
                      <input type="radio" name="analytics_google_tag_manager_view_cart" value="0" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% else %}
                    <label class="btn btn-success">
                      <input type="radio" name="analytics_google_tag_manager_view_cart" value="1" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger active">
                      <input type="radio" name="analytics_google_tag_manager_view_cart" value="0" checked="checked" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% endif %}
                  </div>
                  <div class="help-block">Відстежує перегляд кошику</div>
                </div>
              </div> #}
              
              <div class="form-group">
                <label class="col-sm-3 control-label">
                  <i class="fa fa-shopping-cart text-info"></i> {{ entry_begin_checkout }}
                  <br><small class="text-muted"><code>begin_checkout</code></small>
                </label>
                <div class="col-sm-9">
                  <div class="btn-group" data-toggle="buttons">
                    {% if analytics_google_tag_manager_begin_checkout %}
                    <label class="btn btn-success active">
                      <input type="radio" name="analytics_google_tag_manager_begin_checkout" value="1" checked="checked" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger">
                      <input type="radio" name="analytics_google_tag_manager_begin_checkout" value="0" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% else %}
                    <label class="btn btn-success">
                      <input type="radio" name="analytics_google_tag_manager_begin_checkout" value="1" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger active">
                      <input type="radio" name="analytics_google_tag_manager_begin_checkout" value="0" checked="checked" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% endif %}
                  </div>
                  <div class="help-block">Відстежує початок процесу оформлення замовлення</div>
                </div>
              </div>
              
              <div class="form-group">
                <label class="col-sm-3 control-label">
                  <i class="fa fa-credit-card text-success"></i> {{ entry_purchase }}
                  <br><small class="text-muted"><code>purchase</code></small>
                </label>
                <div class="col-sm-9">
                  <div class="btn-group" data-toggle="buttons">
                    {% if analytics_google_tag_manager_purchase %}
                    <label class="btn btn-success active">
                      <input type="radio" name="analytics_google_tag_manager_purchase" value="1" checked="checked" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger">
                      <input type="radio" name="analytics_google_tag_manager_purchase" value="0" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% else %}
                    <label class="btn btn-success">
                      <input type="radio" name="analytics_google_tag_manager_purchase" value="1" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger active">
                      <input type="radio" name="analytics_google_tag_manager_purchase" value="0" checked="checked" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% endif %}
                  </div>
                  <div class="help-block">Відстежує завершені покупки</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label">
                  <i class="fa fa-search text-info"></i> {{ entry_view_search_results}}
                  <br><small class="text-muted"><code>view_search_results</code></small>
                </label>
                <div class="col-sm-9">
                  <div class="btn-group" data-toggle="buttons">
                    {% if analytics_google_tag_manager_view_search_results %}
                    <label class="btn btn-success active">
                      <input type="radio" name="analytics_google_tag_manager_view_search_results" value="1" checked="checked" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger">
                      <input type="radio" name="analytics_google_tag_manager_view_search_results" value="0" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% else %}
                    <label class="btn btn-success">
                      <input type="radio" name="analytics_google_tag_manager_view_search_results" value="1" />
                      <i class="fa fa-check"></i> {{ text_enabled }}
                    </label>
                    <label class="btn btn-danger active">
                      <input type="radio" name="analytics_google_tag_manager_view_search_results" value="0" checked="checked" />
                      <i class="fa fa-times"></i> {{ text_disabled }}
                    </label>
                    {% endif %}
                  </div>
                  <div class="help-block">Відстежує пошук</div>
                </div>
              </div>
              
              <div class="alert alert-warning">
                <i class="fa fa-lightbulb-o"></i>
                <strong>Підказка:</strong> Після збереження налаштувань подій, не забудьте створити відповідні тригери в Google Tag Manager 
                для кожної увімкненої події.
              </div>
              
            </div>
            
          </div>
          
        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
$(document).ready(function() {
    // Підказки
    $('[data-toggle="tooltip"]').tooltip();
});
</script>

{{ footer }}