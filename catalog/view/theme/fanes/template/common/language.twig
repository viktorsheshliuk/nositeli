<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-language">
  <div class="informer languages">
    <div class="fn_switch lang_switch">
      {# Текущий выбранный язык #}
      {% for language in languages %}
        {% if language.code == code %}
          <span class="informer_name">{{ language.code|slice(-2) }}</span>
        {% endif %}
      {% endfor %}
      <i class="angle_icon tablet-hidden"></i>
      {# Выпадающий список языков #}
      <div class="dropdown">
        {% for language in languages %}
          <a class="dropdown_item {% if language.code == code %}active{% endif %}" 
             href="javascript:void(0);" 
             onclick="$('#form-language input[name=\'code\']').val('{{ language.code }}').parent().submit();">
            <span>{{ language.code|slice(-2) }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
  <input type="hidden" name="code" value="" />
  <input type="hidden" name="redirect" value="{{ redirect }}" />
</form>