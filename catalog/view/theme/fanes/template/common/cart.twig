<div id="cart" class="header_informers__item d-flex align-items-center justify-content-center cart_informer button--blick">
  
  <!-- Кнопка/ссылка корзины: ведёт на оформление заказа (SimpleCheckout подменяет стандартные ссылки) -->
  <button id="desktop_cart" class="dropdown-toggle cart_info d-flex align-items-center informers_item" data-placement="bottom" onclick="location='{{ cart }}';" style="background: none; border: none; padding: 0; cursor: pointer;">
    
    <div class="informers_icon d-flex align-items-center">
      <!-- Иконка корзины от донора -->
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 2H3.87668L6.03418 14.6058H17.5409M5.87264 11.6969H17.3121C17.3969 11.6969 17.4792 11.6678 17.5448 11.6145C17.6105 11.5613 17.6554 11.4871 17.6721 11.4046L18.9929 4.85931C19.0035 4.80653 19.0022 4.75206 18.9891 4.69984C18.9759 4.64762 18.9512 4.59895 18.9168 4.55733C18.8823 4.51571 18.839 4.4822 18.7899 4.45919C18.7408 4.43619 18.6872 4.42428 18.6329 4.42432H4.4051M7.3227 17.2727C7.3227 17.6744 6.99598 18 6.59295 18C6.18992 18 5.86321 17.6744 5.86321 17.2727C5.86321 16.8711 6.18992 16.5455 6.59295 16.5455C6.99598 16.5455 7.3227 16.8711 7.3227 17.2727ZM17.5393 17.2727C17.5393 17.6744 17.2126 18 16.8096 18C16.4065 18 16.0798 17.6744 16.0798 17.2727C16.0798 16.8711 16.4065 16.5455 16.8096 16.5455C17.2126 16.5455 17.5393 16.8711 17.5393 17.2727Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      
      <!-- Текст "Кол-во товаров" или название -->
      <span class="cart_title ml-2">{{ text_shopping_cart|default('Корзина') }}</span>
      
      <!-- Счетчик товаров (ваш id="cart-total" нужен для AJAX-обновления OpenCart) -->
      <span class="cart_counter menu_counter" id="cart-total">{{ text_items }}</span>
    </div>

    <!-- Общая сумма (берется из последней строки totals или выводится динамически) -->
    <span class="cart_total fn_discount" data-discount="0">
      <span class="total_sum_header">
        {% if totals %}
          {{ totals|last.text }}
        {% else %}
          0,00
        {% endif %}
      </span>
    </span>

  </button>
</div>
