            <div class="languages_wrapper">{{ language }}</div>
          </div>
        </div>
      </div>
      <div class="header__bottom">
        <div class="container">
          <div class="header_bottom_wrapper">
            <div class="header_bottom_bl">
              <div class="fn_menu_switch menu_switch d-flex tablet_menu {#menu_switch_icon#}">{# menu_switch_icon добавить клас если есть закладки или избранное для точки #}
                <svg width="32" height="22" viewBox="0 0 32 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1H31" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path> <path d="M1 11H31" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path> <path d="M1 21H31" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
              </div>
              <div class="fn_catalog_switch button--blick catalog_button d-lg-flex desktop_cat_btn">
                <div class="catalog_button__heading d-flex align-items-center">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="1.75" y="1.75" width="6.32609" height="6.32609" rx="3.16304" stroke="currentColor" stroke-width="1.5"></rect> <rect x="1.75" y="11.9239" width="6.32609" height="6.32609" rx="3.16304" stroke="currentColor" stroke-width="1.5"></rect> <rect x="11.9243" y="1.75" width="6.32609" height="6.32609" rx="3.16304" stroke="currentColor" stroke-width="1.5"></rect> <rect x="11.9243" y="11.9239" width="6.32609" height="6.32609" rx="3.16304" stroke="currentColor" stroke-width="1.5"></rect>
                  </svg>
                  <span class="">{{ text_catalog }}</span>
                </div>
              </div>
              {{ search }}
              <div class="header_informers d-flex align-items-center">
                <div class="header_informers__item user_logIn d-flex align-items-center justify-content-center small-hidden">
                  <a href="{{ account }}">
                    <span class="account_link">
                      <svg width="18" height="20" viewBox="0 0 18 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 19V18C1 14.69 3.61358 12 6.82955 12H10.7159C13.9319 12 16.5455 14.69 16.5455 18V19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M8.77308 9C6.62587 9 4.88672 7.21 4.88672 5C4.88672 2.79 6.62587 1 8.77308 1C10.9203 1 12.6594 2.79 12.6594 5C12.6594 7.21 10.9203 9 8.77308 9Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                      <span class="account_name">{% if logged %}{{ text_account }}{% else %}{{ text_entry }}{% endif %}</span>
                    </span>
                  </a>
                  <div id="account-link" class="dropdown">
                    {% if logged %}
                      <a class="dropdown_item" href="{{ logout }}">{{ text_logout }}</a>
                    {% else %}
                      <a class="dropdown_item" href="{{ login }}">{{ text_login }}</a>
                      <a class="dropdown_item" href="{{ register }}">{{ text_register }}</a>
                    {% endif %}
                  </div>
                </div>
