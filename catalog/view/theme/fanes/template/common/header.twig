                    <div class="informers_icon d-flex">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5.95 2C3.21625 2 1 4.24573 1 7.01585C1 12.0317 6.85 16.5915 10 17.6522C13.15 16.5915 19 12.0317 19 7.01585C19 4.24573 16.7837 2 14.05 2C12.376 2 10.8955 2.84221 10 4.13128C9.54348 3.47256 8.93708 2.93496 8.23211 2.56398C7.52715 2.19299 6.74436 1.99955 5.95 2Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
