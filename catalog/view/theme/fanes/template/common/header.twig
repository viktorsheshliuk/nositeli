                        </a>
                      </li>
                    </ul>
                  </li> #}
                <li class="menu_item menu_item_1">
                  <a class="menu_link m_menu_link" href="{{ delivery_payment }}"><span>{{ text_delivery }}</span></a>
                </li>
                <li class="menu_item menu_item_1">
                  <a class="menu_link m_menu_link" href="{{ contact }}"><span>{{ text_contact }}</span></a>
                </li>
              </ul>
            </div>
          </div>

          <div class="header_items_wrapper">
            {# <div class="callback_wrapper fn_switch">
