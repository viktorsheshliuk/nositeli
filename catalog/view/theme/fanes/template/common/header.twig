                        <path d="M19.8893 10.583L17.0011 3.3625C16.9535 3.24339 16.8651 3.14509 16.7517 3.08508C16.6383 3.02508 16.5073 3.00729 16.382 3.03486L10.5415 4.33275V2.11967C10.5415 1.97604 10.4845 1.8383 10.3829 1.73675C10.2814 1.63518 10.1436 1.57812 9.99999 1.57812C9.85637 1.57812 9.71863 1.63518 9.61708 1.73675C9.51551 1.8383 9.45845 1.97604 9.45845 2.11967V4.57373L3.38422 5.92758C3.29816 5.9467 3.21808 5.98653 3.15091 6.04363C3.08375 6.10072 3.03155 6.17335 2.99881 6.25521L0.110615 13.4758C0.0857457 13.5384 0.0725905 13.6051 0.0718079 13.6724C0.0718079 15.6454 2.17568 16.3801 3.50155 16.3801C4.82741 16.3801 6.93129 15.6454 6.93129 13.6724C6.93106 13.6036 6.91789 13.5353 6.89248 13.4712L4.24074 6.84277L9.45845 5.68298V17.4632H7.83385C7.69022 17.4632 7.55248 17.5202 7.45093 17.6218C7.34936 17.7233 7.2923 17.8611 7.2923 18.0048C7.2923 18.1484 7.34936 18.2862 7.45093 18.3877C7.55248 18.4893 7.69022 18.5463 7.83385 18.5463H12.1662C12.3098 18.5463 12.4476 18.4893 12.5491 18.3877C12.6507 18.2862 12.7077 18.1484 12.7077 18.0048C12.7077 17.8611 12.6507 17.7233 12.5491 17.6218C12.4476 17.5202 12.3098 17.4632 12.1662 17.4632H10.5415V5.442L15.6148 4.3147L13.1076 10.583C13.0821 10.6471 13.0689 10.7153 13.0687 10.7843C13.0687 12.7572 15.1725 13.4919 16.4984 13.4919C17.8243 13.4919 19.9282 12.7572 19.9282 10.7843C19.9279 10.7153 19.9148 10.6471 19.8893 10.583ZM3.50155 15.2971C2.94967 15.2928 2.40753 15.1513 1.92387 14.8856C1.43919 14.603 1.18828 14.2375 1.1576 13.769L3.50426 7.91051L5.85091 13.769C5.76337 15.0128 4.09544 15.2971 3.50155 15.2971ZM16.4984 12.4089C15.9466 12.4046 15.4045 12.2631 14.9207 11.9974C14.4361 11.7148 14.1852 11.3493 14.1545 10.8808L16.5011 5.02231L18.8478 10.8808C18.7602 12.1246 17.0923 12.4089 16.4984 12.4089Z" fill="currentColor"></path>
                      </svg>
                      <span class="informer_counter menu_counter hidden">0</span>
                    </div>
                  </a>
                </div>
                {{ desktop_cart }}
              </div>
            </div>
          </div>
        </div>
