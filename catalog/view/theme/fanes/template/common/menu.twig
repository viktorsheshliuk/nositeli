<div class="nav-menu align-items-center" id="desktop-menu">
    <div class="menu-block">
        {% if categories %}
        <ul class="menu">
            {% for category in categories %}
                {% if category.children %}
                    <li class="dropdown">
                        <a href="{{ category.href }}" class="dropdown-toggle" data-toggle="dropdown">{{ category.name }}</a>
                        <div  class="dropdown-menu"><!-- id="m" --> 
                            <div class="dropdown-inner">
                                {% for children in category.children|batch(category.children|length / category.column|round(1, 'ceil')) %}
                                <ul class="list-unstyled">
                                    {% for child in children %}
                                    <li><a href="{{ child.href }}">{{ child.name }}</a></li>
                                    {% endfor %}
                                </ul>
                                {% endfor %}
                                <a href="{{ category.href }}" class="see-all">{{ text_menu_all }} {{ category.name }}</a>
                            </div>
                        </div>
                    </li>
                {% else %}
                    <li><a href="{{ category.href }}">{{ category.name }}</a></li>
                {% endif %}
            {% endfor %}
        </ul>
        {% endif %}
    </div>
</div>
<div class="mobile-menu">
    <div class="mobile-menu-header d-flex align-items-center justify-content-start">
        <a class="logo_menu d-flex" href="/"> <img src="catalog/view/theme/fanes/image/logo-mobile.svg" alt="лого"> </a>
        {{ language }}
