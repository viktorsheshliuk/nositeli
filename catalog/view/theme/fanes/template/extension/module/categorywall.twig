<div class="category__wall-module">
	{# <div class="container"> #}
		<div class="main_h2 heading_flex heading_margin">
			<h2>{{ heading_title }}</h2>
			{# <a class="block__more d-flex align-items-center" href="categories-all">
				<span>Всі категорії</span>
			</a> #}
		</div>
		
		
			<div class="categories_grid">
				{% for category in categories %}
				<a class="f_category_item" href="{{ category.href }}">
					<div class="f_category_icon">
						<img class="" src="{{ category.image }}" alt="{{ category.name }} - іконка" title="{{ category.name }}">
					</div>
					<div class="f_category_name">{{ category.name }}</div>
				</a>
				{% endfor %}
			</div>
		
		
	{# </div>	 #}
</div>	