<div class="module-block">

  <div class="heading_flex">
    <h2 class="main_discount_products">{{ heading_title}}</h2>
    <a class="block__more d-flex align-items-center" href="{{ all_specials }}">
      <span>{{ text_all_specials }}</span>
    </a>
  </div>

  <div class="special main_products swiper">
    <div class="swiper-wrapper">
      {% for product in products %}
        {% include 'fanes/template/product/thumb/swiper.twig' %}
      {% endfor %}
    </div>

    <div class="swiper-button-prev" tabindex="0" role="button" aria-label="Previous slide">
      <svg width="10" height="21" viewBox="0 0 10 21" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M9 20L1 10.5L9 1" stroke="currentColor" stroke-linecap="round"></path> </svg>
    </div>
    <div class="swiper-button-next" tabindex="0" role="button" aria-label="Next slide">
      <svg width="10" height="21" viewBox="0 0 10 21" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M9 20L1 10.5L9 1" stroke="currentColor" stroke-linecap="round"></path> </svg>
    </div>
    <div class="swiper-pagination-product"></div>
  </div>  

</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const productsSlider = new Swiper('.main_products', {
        slidesPerView: 1, // Сколько карточек показывать на экране по умолчанию
        spaceBetween: 10, // Расстояние между карточками в пикселях
        loop: true,       // Бесконечный скролл
        autoHeight: false,
        watchSlidesProgress: true,
        navigation: {
              nextEl: '.swiper-button-next',
              prevEl: '.swiper-button-prev',
        },
        pagination: {
                el: '.swiper-pagination-product',
                clickable: true,
        },
        
        breakpoints: {
          
          1550: {
            slidesPerView: 4,
            pagination: {
              enabled: false
            },
          },
          992: {
            slidesPerView: 3,
            pagination: {
              enabled: false
            },
          },
          //850: {
           // slidesPerView: 3,
          //},
          550: {
            slidesPerView: 2,
          },
          0: {
            slidesPerView: 1,
            
          },

        }
    });
});
</script>