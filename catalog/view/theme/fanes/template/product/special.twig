{{ header }}
<div class="container">
 <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
<div class="content">
  {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'product-card product-card-s' %}
    {% elseif column_left or column_right %}
    {% set class = 'product-card product-card-l' %}
    {% else %}
    {% set class = 'product-card' %}
    {% endif %}
    <div id="product-search" class="content-center">
     {{ content_top }}
      <h1 class="heading-title">{{ heading_title }}</h1>
      {% if products %}
      <div class="sort-block">
        <div class="sort">
          <div class="form-group input-group input-group-sm">
            {# <label class="input-group-addon" for="input-sort">{{ text_sort }}</label> #}
            <select id="input-sort" class="form-control" onchange="location = this.value;">
              {% for sorts in sorts %}
              {% if sorts.value == '%s-%s'|format(sort, order) %}
              <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
              {% else %}
              <option value="{{ sorts.href }}">{{ sorts.text }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </div>
        </div>
        <div class="view-switcher">
          <!-- Кнопка: 1 колонка -->
          <button type="button" class="view-btn" data-view="1" title="1 колонка">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <rect x="4" y="4" width="16" height="4" rx="1.5"/>
                <rect x="4" y="10" width="16" height="4" rx="1.5"/>
                <rect x="4" y="16" width="16" height="4" rx="1.5"/>
              </svg>
          </button>
          <!-- Кнопка: 2 колонки -->
          <button type="button" class="view-btn" data-view="2" title="2 колонки">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <rect x="3" y="4" width="8" height="7" rx="1.5"/>
                <rect x="13" y="4" width="8" height="7" rx="1.5"/>
                <rect x="3" y="13" width="8" height="7" rx="1.5"/>
                <rect x="13" y="13" width="8" height="7" rx="1.5"/>
              </svg>
          </button>
        </div>
      </div>
      <div class="product-wrapp">
  {% for product in products %}
    {% include 'fanes/template/product/thumb/default.twig' %}
  {% endfor %}
</div>
    <div class="pagination-block">
        <div class="paginations">{{ pagination }}</div>
        <div class="results-text">{{ results }}</div>
      </div>
      {% else %}
      <p>{{ text_empty }}</p>
      <div class="buttons">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {% endif %}
      </div>
    {{ column_right }}
</div>
{{ content_bottom }}
</div>
{{ footer }}