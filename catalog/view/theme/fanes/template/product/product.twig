              </a>
              {% if attribute_groups %}
              <a class="tabs__link" href="{{ product_link }}#features">
                <span>{{ tab_attribute_2 }}</span>
              </a>
              {% endif %}
              {% if description %}
              <a class="tabs__link" href="{{ product_link }}#description">
                <span>{{ tab_description }}</span>
              </a>
              {% endif %}
              {% if review_status %}
              <a id="fn_tab_comments" class="tabs__link" href="{{ product_link }}#comments">
                <span>{{ tab_review }}</span>
              </a>
              {% endif %}

            </div>
