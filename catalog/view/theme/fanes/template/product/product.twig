<div class="container">
  <div class="content">
    {{ column_left }}
      {# {% if column_left and column_right %}
      {% set class = 'thumbnails-block small' %}
      {% elseif column_left or column_right %}
      {% set class = 'thumbnails-block small' %}
      {% else %}
      {% set class = 'thumbnails-block' %}
      {% endif %} #}
      <div id="product-product" class="content-center">
      {{ content_top }}
        {# <h1 class="heading-title">{{ heading_title }}</h1> #}
        <div class="product-wrapp">
          <div class="left-panel {#{{ class }}#}">
            <div class="product_all_images">
            {% if thumb or images %}
                <!-- 1. Главный слайдер -->
                <div class="fn_images_main swiper">
                  <div class="swiper-wrapper">
                    
                    <!-- Главное (основное) фото -->
                    {% if thumb %}
                      <a class="images_link swiper-slide" href="{{ popup }}" data-fancybox="group" title="{{ heading_title }}" data-caption="{{ heading_title }} #1">
                        <img class="fn_image" src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" />
                      </a>
                    {% endif %}
                    
                    <!-- Дополнительные фото -->
                    {% if images %}
                      {% for image in images %}
                        <a class="images_link swiper-slide" href="{{ image.popup }}" data-fancybox="group" data-caption="{{ heading_title }} #{{ loop.index + 1 }}" title="{{ heading_title }}">
                          <img src="{{ image.thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" />
                        </a>
                      {% endfor %}
                    {% endif %}
                    
                  </div>
                  <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span>
                </div>

                <!-- 2. Блок миниатюр (превью) -->
                <div class="fn_images_nav images clearfix swiper swiper-thumbs">
                  <div class="swiper-wrapper">
                    
                    <!-- Миниатюра для главного фото -->
                    {% if thumb %}
                      <div class="images_item swiper-slide">
                        <a class="images_link">
                          <img src="{{ small }}" title="{{ heading_title }}" alt="{{ heading_title }}" />
                        </a>
                      </div>
                    {% endif %}
                    
                    <!-- Миниатюры для дополнительных фото -->
                    {% if images %}
                      {% for image in images %}
                        <div class="images_item swiper-slide">
                          <a class="images_link">
                            <img src="{{ image.small }}" title="{{ heading_title }}" alt="{{ heading_title }}" />
                          </a>
                        </div>
                      {% endfor %}
                    {% endif %}
                    
                  </div>
                  
                  <!-- Навигация (стрелки) -->
                  <div class="swiper-button-prev" tabindex="0" role="button" aria-label="Previous slide">
                    <svg width="10" height="21" viewBox="0 0 10 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 20L1 10.5L9 1" stroke="currentColor" stroke-linecap="round"></path>
                    </svg>
                  </div>
                  <div class="swiper-button-next" tabindex="0" role="button" aria-label="Next slide">
                    <svg width="10" height="21" viewBox="0 0 10 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 20L1 10.5L9 1" stroke="currentColor" stroke-linecap="round"></path>
                    </svg>
                  </div>
                  
                  <!-- Пагинация (опционально) -->
                  <div class="swiper-pagination"></div>
                  <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span> 
                </div>
            {% endif %}
            </div>
          </div>
        
          <div class="right-panel">
            <div class="product_details"> 
              <div class="product_details_item" id="main">
                <div class="product_header_wrapper">
                  <div class="available">
                    <span class="no_stock fn_not_stock {% if ostatok > 0 %}hidden{% endif %}">{{ text_outstock }}</span>
                    <span class="in_stock fn_in_stock {% if ostatok < 1 %}hidden{% endif %}">{{ text_instock }}</span>
                  </div>
                  <div class="rating_wrapper">
                  </div>
                  <div class="product_code">
                    {{ text_model }}
                    <span class="product_code_nubmer">{{ model }}</span> 
                  </div>
                </div>
                <ul class="list-unstyled">
                  {% if manufacturer %}
                  <li>{{ text_manufact }} <a href="{{ manufacturers }}">{{ manufacturer }}</a></li>
                  {% endif %}
                  <li>{{ text_stock }} {{ stock }}</li>
                </ul>
                {% if stock_status_id == 9 and ostatok <= 0 %}
                  <div id="product_unavailable">{{text_unavailable}}</div>
                {% endif %}
                {% if price %}
                  {% if stock_status_id != 9 or ostatok > 0 %}
                  <div class="price-block {% if ostatok < 1 %}price_gray{% endif %}">
                    <div class="text-price">{{ text_price_1 }}</div>
                    {% if not special %}
                      <div class="price {% if ostatok < 1 %}price_gray{% endif %}">
                          <div class="fn_price">{{ price }}</div>
                          <div class="currency">{{ symbol_right }}</div> 
                      </div>
                    {% else %}
                    {# <span style="text-decoration: line-through;">{{ price }}</span> #}
                      <div class="price red-price">
                        <div class="fn_price">{{ special }}</div>
                        <div class="currency">{{ symbol_right }}</div>
                      </div>
                      
                      <div class="old_price_box">
                        <div class="fn_discount_label ">{{ discount_percent }}</div>
                        <div class="old_price">
                          <span class="fn_old_price">{{ price }}</span>
                          {{ symbol_right }}
                        </div>
                      </div>

                    {% endif %}
                  </div>
                    <ul class="list-unstyled">
                      {# {% if points %}
                      <li>{{ text_points }} {{ points }}</li>
                      {% endif %} #}
                      {% if discounts %}
                      <li><b>{{ text_pri_pokupke }}</b></li>
                      {% for discount in discounts %}
                      <li>{{ discount.quantity }}{{ text_discount }}{{ discount.price }}</li>
                      {% endfor %}
                      {% endif %}
                    </ul>
                  {% endif %}
                {% endif %}
                <div id="product"> {% if options %}
                  <h3 class="heading-title">{{ text_option }}</h3>
                  {% for option in options %}
                  {% if option.type == 'select' %}
                  <div class="form-group{% if option.required %} required {% endif %}">
                    <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
                    <select name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" class="form-control">
                      <option value="">{{ text_select }}</option>
                      {% for option_value in option.product_option_value %}
                      <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}
                      {% if option_value.price %}
                      ({{ option_value.price_prefix }}{{ option_value.price }})
                      {% endif %} </option>
                      {% endfor %}
                    </select>
                  </div>
                  {% endif %}
                  {% if option.type == 'radio' %}
                  <div class="form-group{% if option.required %} required {% endif %}">
                    <label class="control-label">{{ option.name }}</label>
                    <div id="input-option{{ option.product_option_id }}"> {% for option_value in option.product_option_value %}
                      <div class="radio">
                        <label>
                          <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" data-radiobutton="my" />
                          {% if option_value.image %} <img src="{{ option_value.image }}" alt="{{ option_value.name }} {% if option_value.price %} {{ option_value.price_prefix }} {{ option_value.price }} {% endif %}" class="img-thumbnail" /> {% endif %}                  
                          {{ option_value.name }}
                          {% if option_value.price %}
                          ({{ option_value.price_prefix }}{{ option_value.price }})
                          {% endif %} </label>
                      </div>
                      {% endfor %} </div>
                  </div>
                  {% endif %}
                  {% if option.type == 'checkbox' %}
                  <div class="form-group{% if option.required %} required {% endif %}">
                    <label class="control-label">{{ option.name }}</label>
                    <div id="input-option{{ option.product_option_id }}"> {% for option_value in option.product_option_value %}
                      <div class="checkbox">
                        <label>
                          <input type="checkbox" name="option[{{ option.product_option_id }}][]" value="{{ option_value.product_option_value_id }}" />
                          {% if option_value.image %} <img src="{{ option_value.image }}" alt="{{ option_value.name }} {% if option_value.price %} {{ option_value.price_prefix }} {{ option_value.price }} {% endif %}" class="img-thumbnail" /> {% endif %}
                          {{ option_value.name }}
                          {% if option_value.price %}
                          ({{ option_value.price_prefix }}{{ option_value.price }})
                          {% endif %} </label>
                      </div>
                      {% endfor %} </div>
                  </div>
                  {% endif %}
