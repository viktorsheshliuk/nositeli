<script><!--
  $('#button-cart').on('click', function() {
    $.ajax({
      url: 'index.php?route=checkout/cart/add',
      type: 'post',
      data: $('#product input[type=\'text\'], #product input[type=\'hidden\'], #product input[type=\'radio\']:checked, #product input[type=\'checkbox\']:checked, #product select, #product textarea'),
      dataType: 'json',
      beforeSend: function() {
        $('#button-cart').button('loading');
      },
      complete: function() {
        $('#button-cart').button('reset');
      },
      success: function(json) {
        $('.alert-dismissible, .text-danger').remove();
        $('.form-group').removeClass('has-error');

        if (json['error']) {
          if (json['error']['option']) {
            for (i in json['error']['option']) {
              var element = $('#input-option' + i.replace('_', '-'));

              if (element.parent().hasClass('input-group')) {
                element.parent().after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
              } else {
                element.after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
              }
            }
          }

          if (json['error']['recurring']) {
            $('select[name=\'recurring_id\']').after('<div class="text-danger">' + json['error']['recurring'] + '</div>');
          }

          // Highlight any found errors
          $('.text-danger').parent().addClass('has-error');
        }

        if (json['success']) {
          $('.breadcrumb').after('<div class="event-block"><i class="fa fa-check-circle"></i>' + json['success'] + '</div>');

          $('#cart > a').html('<span id="cart-total"><i class="fa fa-shopping-bag" aria-hidden="true"></i> ' + json['total'] + '</span>');

          

          $('#cart ul').load('index.php?route=common/cart/info ul li');
        }
      },
          error: function(xhr, ajaxOptions, thrownError) {
              alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
          }
    });
  });   
  $('#review').delegate('.pagination a', 'click', function(e) {
      e.preventDefault();

      $('#review').fadeOut('slow');

      $('#review').load(this.href);

      $('#review').fadeIn('slow');
  });

  $('#review').load('index.php?route=product/product/review&product_id={{ product_id }}');

  $('#button-review').on('click', function() {
    $.ajax({
      url: 'index.php?route=product/product/write&product_id={{ product_id }}',
      type: 'post',
      dataType: 'json',
      data: $("#form-review").serialize(),
      beforeSend: function() {
        $('#button-review').button('loading');
      },
      complete: function() {
        $('#button-review').button('reset');
      },
      success: function(json) {
        $('.alert-dismissible').remove();

        if (json['error']) {
          $('#review').after('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '</div>');
        }

        if (json['success']) {
          $('#review').after('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + '</div>');

          $('input[name=\'name\']').val('');
          $('textarea[name=\'text\']').val('');
          $('input[name=\'rating\']:checked').prop('checked', false);
        }
      }
    });
  });

  $('button[id^=\'button-upload\']').on('click', function() {
    var node = this;

    $('#form-upload').remove();

    $('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="file" name="file" /></form>');

    $('#form-upload input[name=\'file\']').trigger('click');

    if (typeof timer != 'undefined') {
        clearInterval(timer);
    }

    timer = setInterval(function() {
      if ($('#form-upload input[name=\'file\']').val() != '') {
        clearInterval(timer);

        $.ajax({
          url: 'index.php?route=tool/upload',
          type: 'post',
          dataType: 'json',
          data: new FormData($('#form-upload')[0]),
          cache: false,
          contentType: false,
          processData: false,
          beforeSend: function() {
            $(node).button('loading');
          },
          complete: function() {
            $(node).button('reset');
          },
          success: function(json) {
            $('.text-danger').remove();

            if (json['error']) {
              $(node).parent().find('input').after('<div class="text-danger">' + json['error'] + '</div>');
            }

            if (json['success']) {
              alert(json['success']);

              $(node).parent().find('input').val(json['code']);
            }
          },
          error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
          }
        });
      }
    }, 500);
  });

//--></script>

<script><!--
document.addEventListener('DOMContentLoaded', function () {
    // Функция для синхронизации высоты миниатюр с главным слайдером
    function syncThumbsHeight() {
        const mainSlider = document.querySelector('.fn_images_main');
        const thumbsSlider = document.querySelector('.fn_images_nav');

        if (!mainSlider || !thumbsSlider) return;

        // Если экран меньше 576px (мобилка, где слайдер горизонтальный снизу)
        if (window.innerWidth < 576) {
            thumbsSlider.style.height = ''; // Сбрасываем инлайн-высоту, отдав ее на откуп CSS
            return;
        }

        // Для десктопов и планшетов (>= 576px) — синхронизируем высоту
        const mainHeight = mainSlider.offsetHeight;

        // Защита: не записываем "мусорную" высоту (0-2px),
        // пока главное изображение ещё не загрузилось и слайдер не набрал реальную высоту
        if (mainHeight < 50) {
            return;
        }

        thumbsSlider.style.height = mainHeight + 'px';
    }

    // 1. Инициализируем слайдер с миниатюрами
    const galleryThumbs = new Swiper('.fn_images_nav', {
        spaceBetween: 18,        // Расстояние между миниатюрами
        slidesPerView: 'auto',        // Сколько миниатюр показывать по умолчанию
        freeMode: true,          // Свободное перетаскивание
        watchSlidesProgress: true, // Следить за прогрессом слайдов
        direction: 'vertical',   // Вертикальное расположение (как на сайте-примере)
        navigation: {
            nextEl: '.fn_images_nav .swiper-button-next',
            prevEl: '.fn_images_nav .swiper-button-prev',
        },
        pagination: {
            el: '.fn_images_nav .swiper-pagination',
            clickable: true,
            dynamicBullets: true,
        },
        // Адаптивные настройки самого Swiper под мобилки
        breakpoints: {
            0: {
                direction: 'horizontal', // На мобилках миниатюры крутятся горизонтально
                spaceBetween: 12,
                navigation: false,
            },
            577: {
                direction: 'vertical',   // От 576px и выше — строго вертикально
            }
        }
    });

    // 2. Инициализируем главный слайдер и привязываем к нему миниатюры
    const galleryMain = new Swiper('.fn_images_main', {
        spaceBetween: 0,
        navigation: {
            nextEl: '.fn_images_main .swiper-button-next',
            prevEl: '.fn_images_main .swiper-button-prev',
        },
        thumbs: {
            swiper: galleryThumbs, // Связка с блоком миниатюр выше
        },
    });

    // Вызываем синхронизацию высоты сразу после инициализации слайдеров.
    // Используем двойной requestAnimationFrame, чтобы дождаться первого кадра отрисовки
    requestAnimationFrame(function () {
        requestAnimationFrame(syncThumbsHeight);
    });

    // Пересчитываем высоту после полной загрузки страницы (все изображения загружены)
    window.addEventListener('load', syncThumbsHeight);

    // И повторяем при изменении размера окна браузера (адаптив)
    window.addEventListener('resize', syncThumbsHeight);

    // Автоматически синхронизируем высоту при любом изменении размеров главного слайдера
    // (догрузка картинок, lazy-load, смена слайда и т.п.)
    if ('ResizeObserver' in window) {
        const mainSliderEl = document.querySelector('.fn_images_main');
        if (mainSliderEl) {
            const resizeObserver = new ResizeObserver(function () {
                syncThumbsHeight();
            });
            resizeObserver.observe(mainSliderEl);
        }
    }

    // Инициализация Fancybox для всех элементов с атрибутом data-fancybox
    Fancybox.bind("[data-fancybox]", {
      Thumbs: false,
    });



    // 1. Инициализация: делаем первую вкладку активной при загрузке
    $(".tabs_navigation_product .container").find(".tabs_buttons").children().first().addClass("selected");

    // 2. Плавная прокрутка при клике на вкладку
    $(document).on("click", ".tabs__link", function(e) {
        e.preventDefault();
        
        let headerHeight = $(".header__bottom").outerHeight() || 0;
        let navHeight = $(".tabs_navigation_product").outerHeight() || 0;
        let targetHref = $(this).attr("href");
        
        if (!targetHref || targetHref.indexOf("#") === -1) return;
        
        let targetId = targetHref.split("#")[1];
        if (!targetId) return;
        
        let $targetElement = $("#" + targetId);
        if ($targetElement.length > 0) {
            // Вычисляем позицию с учетом высоты шапки, липкой панели и небольшого отступа (56px)
            let scrollTo = $targetElement.offset().top - headerHeight - navHeight - 56;
            
            $("body, html").animate({
                scrollTop: scrollTo
            }, 800);
        }
    });

    // 3. Фиксация шапки и панели при скролле
    $(window).on("load scroll", function() {
        let scrollTop = $(document).scrollTop();
        // Проверяем, находимся ли мы на странице товара
        let isProductPage = $("body").hasClass("product-product");

        if (scrollTop < 140) {
            $(".header__bottom, .header__catalog").removeClass("fixed");
            $(".main").css("padding-top", "0");
            if (isProductPage) {
                $(".tabs_navigation_product").removeClass("fixed");
                $(".tabs_product_card").removeClass("show");
            }
        } else {
            $(".header__bottom, .header__catalog").addClass("fixed");
            if (isProductPage) {
                if (scrollTop < 370) {
                    $(".tabs_navigation_product").removeClass("fixed");
                    $(".tabs_product_card").removeClass("show");
                    $(".main").css("padding-top", "50px");
                } else {
                    $(".tabs_navigation_product").addClass("fixed");
                    $(".tabs_product_card").addClass("show");
                    $(".main").css("padding-top", "114px"); // Подстройте это значение под высоту ваших фиксированных элементов
                }
            } else {
                $(".main").css("padding-top", "50px");
            }
        }
    });

    // 4. Автоматическая подсветка активной вкладки при скролле
    $(window).on("load scroll", function() {
        let $detailsItems = $(".product_details_item"); // Блоки с контентом (Описание, Характеристики, Отзывы)
        let $navLinks = $(".tabs__link"); // Ссылки в панели навигации
        let headerHeight = $(".header__bottom").outerHeight() || 0;
        let navHeight = $(".tabs_navigation_product").outerHeight() || 0;
        let currentScroll = $(document).scrollTop() + headerHeight + navHeight + 70;

        $detailsItems.each(function() {
            let $item = $(this);
            let itemTop = $item.offset().top;
            let itemBottom = itemTop + $item.outerHeight();

            if (currentScroll >= itemTop && currentScroll < itemBottom) {
                let itemId = $item.attr("id");
                if (itemId) {
                    $navLinks.removeClass("selected");
                    $navLinks.each(function() {
                        let href = $(this).attr("href");
                        if (href && href.endsWith("#" + itemId)) {
                            $(this).addClass("selected");
                        }
                    });
                }
            }
        });
    });

});


