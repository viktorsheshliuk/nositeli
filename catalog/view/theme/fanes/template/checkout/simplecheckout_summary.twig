    {# {% if not display_products and display_totals_block and display_totals is not empty %}
      <div class="simplecheckout-summary-totals">
    {% endif %} #}

    {% set amount_sub_total = '0' %}
    {% set amount_total = '0' %}
    
    {% for total in totals  %}
        {% if total.code == 'sub_total' %}
          {% set amount_sub_total = total.text|replace({'грн': ''})|trim %}
          {# <div class="simplecheckout-cart-total" id="total_{{ total['code'] }}">
              <span>{{ total.title }}</span>
              <span class="simplecheckout-cart-total-value">{{ total['text'] }}</span>
          </div> #}
        {% endif %}
        {% if total.code == 'total' %}
          {% set amount_total = total.text|replace({'грн': ''})|trim %}
        {% endif %}  
    {% endfor %}

    {% if amount_total != amount_sub_total %}
    {% set total_summa = amount_total %}
    {% endif %}

    <div class="cart_top_right_block">
      <div class="cart_product_count">
        <span class="cart_amount_purchases">{{ count_products }}</span>
        <span class="cart_purchases_text">{{ _self.get_product_label(count_products, text_tovar_1, text_tovar_2, text_tovar_3) }}</span>
          {{ text_in_cart }}
      </div>
      <div class="cart_dash"></div>
      <div class="cart_total_price_container">
        <div class="total_sum nowrap"><span id="total_sum">{{ amount_sub_total }}</span> грн</div>
      </div>
    </div>


    {# 
    {{ monopay.title }} — название (например, «Комиссия Monopay»).
    {{ monopay.text }} — отформатированная строка с ценой (например, 150 ₴).
    {{ monopay.value }} — числовое значение для математических операций (например, 150.0000). #}
    {% if 'monopay_fee' in totals|keys %}

      {% set monopay = null %}
      {% for total in totals %}
          {% if total.code == 'monopay_fee' %}
              {% set monopay = total %}
          {% endif %}
      {% endfor %}
    
      {% if monopay %}
      <div class="cart_top_right_block">
        <div class="cart_product_count">
            {{ monopay.title }}
        </div>
        <div class="cart_dash"></div>
        <div class="cart_total_price_container">
          <div class="total_sum nowrap"><span id="total_sum">{{ monopay.value }}</span> грн</div>
        </div>
      </div>
      {% endif %}
    
    {% endif %}

    {% if total_summa %}
    <div class="cart_top_right_block">
      <div class="cart_product_count">
          {{ text_to_pay }}
      </div>
      <div class="cart_dash"></div>
      <div class="cart_total_price_container">
        <div class="total_sum nowrap"><span id="total_sum">{{ total_summa }}</span> грн</div>
      </div>
    </div>
    {% endif %}

    {% if display_totals_block %}
      {% for total in totals  %}
        {% if total['code'] in display_totals %}
          {# <div class="simplecheckout-cart-total" id="total_{{ total['code'] }}">
              <span>{{ total.title }}</span>
              <span class="simplecheckout-cart-total-value">{{ total['text'] }}</span>
          </div> #}
          

        {% endif %}
      {% endfor %}
    {% endif %}
    

    {# {% if not display_products and display_totals_block and display_totals is not empty %}
      </div>
    {% endif %} #}

