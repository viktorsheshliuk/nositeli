{% macro get_product_label(count, text_tovar_1, text_tovar_2, text_tovar_3) %}
    {% set last_digit = count|split('')|last %}
    {% set last_two = count|slice(-2) %}
    
    {% if count == 0 %}
        {{ text_tovar_2 }}
    {% elseif count == 1 %}
        {{ text_tovar_1 }}
    {% elseif last_two >= 11 and last_two <= 19 %}
       {{ text_tovar_2 }}
    {% elseif last_digit == 1 %}
       {{ text_tovar_1 }}
    {% elseif last_digit >= 2 and last_digit <= 4 %}
        {{ text_tovar_3 }}
    {% else %}
        {{ text_tovar_2 }}
    {% endif %}
{% endmacro %} 
<div class="simplecheckout-block" id="simplecheckout_summary" {{ hide ? 'data-hide="true"' : '' }}>
