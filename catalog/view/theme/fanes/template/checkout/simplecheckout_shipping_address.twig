<div class="simplecheckout-block" id="simplecheckout_shipping_address" {{ hide ? 'data-hide="true"' : '' }} {{ display_error and has_error ? 'data-error="true"' : '' }}>
  {% if display_header %}
    <div class="checkout-heading panel-heading">
      <span>{{ text_checkout_shipping_address }}</span>
    </div>
  {% endif %}
  <div class="simplecheckout-block-content">
    {% for row in rows %}
      {{ row }}
    {% endfor %}
    {% for row in hidden_rows %}
      {{ row }}
    {% endfor %}
 
    <input type="hidden" name="shipping_address[address_ref]" id="shipping_address_address_ref" value="{{ novaposhta_cn_ref }}" />
    <input type="hidden" name="shipping_address[city_ref]" id="shipping_address_city_ref" value="{{ novaposhta_city_ref }}" />
  </div>
</div>
<script>
 $('#simplecheckout_shipping_address:has(select)').addClass('not_empty');
 $('#simplecheckout_shipping_address:has(input[type="text"])').addClass('not_empty');
window.cityPlaceholder = "{{ text_city_placeholder }}";
window.departmentPlaceholder = "{{ text_city_department }}";
</script>